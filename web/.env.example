# Demonstração local: sem conexão com Dynatrace ou autenticação corporativa.
# Não há segredos reais neste arquivo. Não commitar .env.local.
APP_MODE=demo
API_URL=http://localhost:8080/sboot-corp-srep-pop-map-service

# Reservados para integrar ao template corporativo; autenticação não implementada nesta prévia.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
NEXTAUTH_URL=http://localhost:3000/react-ssr-corp-srep-pop-map/api/auth
NEXTAUTH_SECRET=
NEXTAUTH_LOGOUT=

# Se a empresa usa uma CA interna, configurar NODE_EXTRA_CA_CERTS no runtime.
# Nunca desabilitar validação TLS.
